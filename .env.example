# 로컬 개발 전용 예시입니다. 실제 비밀번호로 변경하고 .env는 커밋하지 마세요.
NEO4J_PASSWORD=change-this-local-password
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Qdrant는 외부에 직접 노출하지 말고 반드시 긴 무작위 키를 사용하세요.
QDRANT_API_KEY=replace-with-a-long-random-secret
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=pension_chunks_qwen3_v1

# Dense는 별도 TEI 컨테이너, Sparse는 앱 컨테이너의 FastEmbed를 사용합니다.
EMBEDDING_DENSE_URL=http://localhost:8081
EMBEDDING_DENSE_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DENSE_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
EMBEDDING_DENSE_DIMENSION=1024
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_BATCH_SIZE=4
EMBEDDING_QUERY_INSTRUCTION=Given a Korean pension question, retrieve source passages containing the facts, conditions, exceptions, amounts, taxes, eligibility, or procedures needed to answer it.

# API 공개 포트(클라우드에서는 로드밸런서/리버스 프록시 뒤에 둡니다).
RAG_API_PORT=8080

# 답변 생성 및 별도 의미 검증 HyperCLOVA X. 실제 키는 저장소에 넣지 마세요.
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_STUDIO_MODEL=HCX-007
CLOVA_STUDIO_TIMEOUT_SECONDS=90
CLOVA_STUDIO_MAX_TOKENS=2400
CLOVA_STUDIO_SEED=7
CLOVA_STUDIO_MAX_CONCURRENCY=2
CLOVA_STUDIO_RATE_LIMIT_RETRIES=2
# 의미 검증만 짧은 추론 사용. JSON 스키마는 서버에서 검증합니다.
CLOVA_VERIFIER_THINKING_EFFORT=medium

# KG Builder를 실행할 때만 필요합니다.
# OPENAI_API_KEY=
# auto는 OPENAI_API_KEY가 있으면 OpenAI, 없으면 로컬 Ollama를 사용합니다.
KG_LLM_PROVIDER=auto
# KG_LLM_MODEL=gpt-5.6-sol
